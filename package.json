{
  "name": "cilium-ui",
  "version": "0.2.1",
  "description": "Manage Cilium from Lens: Gateway API designer, network policy builder, live topology, BGP, LB-IPAM, Hubble flows, and schema-driven editing of every Cilium CRD.",
  "keywords": [
    "lens-extension",
    "cilium",
    "gateway-api",
    "network-policy",
    "hubble",
    "ebpf",
    "kubernetes"
  ],
  "license": "MIT",
  "author": "Davit Chaganava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beershop-ge/cilium-gateway-api-extension.git"
  },
  "bugs": {
    "url": "https://github.com/beershop-ge/cilium-gateway-api-extension/issues"
  },
  "homepage": "https://github.com/beershop-ge/cilium-gateway-api-extension#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-extension-dependencies-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/",
    "prepublishOnly": "npm run build && lens-extension-publish-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "package": "scripts/package-zip.sh",
    "vendor": "node scripts/vendor-xyflow.mjs"
  },
  "dependencies": {
    "@k8slens/badge": "^3.0.2",
    "@k8slens/cluster-contracts": "^2.5.2",
    "@k8slens/command-palette-contracts": "^1.3.0",
    "@k8slens/details-panel-contracts": "^1.2.2",
    "@k8slens/electron-contracts": "^1.1.2",
    "@k8slens/element-components": "^3.11.0",
    "@k8slens/feature-core": "^7.5.4",
    "@k8slens/icon": "^4.1.3",
    "@k8slens/injectable": "^26.4.0",
    "@k8slens/input-components": "^1.0.3",
    "@k8slens/kubectl-contracts": "^1.1.2",
    "@k8slens/kubernetes-contracts": "^2.0.4",
    "@k8slens/kubernetes-resources-contracts": "^1.4.0",
    "@k8slens/main-view-contracts": "^1.7.1",
    "@k8slens/modal-components": "^1.3.0",
    "@k8slens/modal-contracts": "^1.0.4",
    "@k8slens/navigation-contracts": "^1.2.0",
    "@k8slens/navigator-components": "^1.0.6",
    "@k8slens/navigator-contracts": "^2.4.0",
    "@k8slens/notifications-contracts": "^1.0.4",
    "@k8slens/persistable-contracts": "^1.0.5",
    "@k8slens/preferences-contracts": "^2.0.2",
    "@k8slens/prometheus-contracts": "^1.0.5",
    "@k8slens/status-bar-contracts": "^1.0.4",
    "@k8slens/stylesheet-contracts": "^1.0.2",
    "@k8slens/subscribable": "^1.2.2",
    "@k8slens/subscribable-react": "^1.0.5",
    "@k8slens/tab-contracts": "^1.5.0",
    "@k8slens/tabs-components": "^1.0.3",
    "@k8slens/use-inject": "^1.0.4",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.3.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "@xyflow/react": "12.12.0",
    "rimraf": "^4.4.1",
    "vitest": "4.1.12"
  }
}
